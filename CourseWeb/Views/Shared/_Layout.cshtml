<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CourseWeb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CourseWeb.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
        :root {
            --coal: #1c1c1e;
            --coal-soft: #2a2a2d;
            --orange: #f97316;
            --orange-dim: rgba(249,115,22,0.12);
            --orange-glow: rgba(249,115,22,0.25);
            --text-primary: #f0ede8;
            --text-muted: #8a8680;
            --border: rgba(255,255,255,0.07);
        }

        * { box-sizing: border-box; }
        body { font-family: 'DM Sans', sans-serif; background: #f5f2ee; color: #1c1c1e; }

        /* ── Navbar ── */
        .navbar {
            background: var(--coal) !important;
            border-bottom: 1px solid var(--border);
            padding: 0;
            position: relative;
            /* overflow: hidden; */
        }
        .navbar::before {
            content: '';
            position: absolute; inset: 0;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");
            pointer-events: none; z-index: 0;
        }
        .navbar .container-fluid { position: relative; z-index: 1; padding: 0 1.5rem; }

        /* Brand */
        .navbar-brand {
            font-family: 'DM Mono', monospace;
            font-weight: 500; font-size: 1.05rem;
            color: var(--text-primary) !important;
            letter-spacing: 0.04em;
            padding: 1rem 0;
            display: flex; align-items: center; gap: 0.5rem;
            text-decoration: none;
        }
        .navbar-brand:hover { opacity: 0.85; }

        .brand-dot {
            width: 8px; height: 8px;
            background: var(--orange); border-radius: 50%;
            box-shadow: 0 0 8px var(--orange-glow);
            animation: pulseDot 2.5s ease-in-out infinite;
        }
        /* 用 @@keyframes 避免 Razor 解析錯誤 */
        @@keyframes pulseDot {
            0%,100% { box-shadow: 0 0 6px var(--orange-glow); }
            50%      { box-shadow: 0 0 14px var(--orange), 0 0 24px var(--orange-dim); }
        }

        /* Nav links */
        .nav-link-custom {
            font-size: 0.875rem; font-weight: 500;
            color: var(--text-muted) !important;
            padding: 1rem 0.9rem !important;
            transition: color 0.2s ease;
            display: flex; align-items: center; gap: 0.4rem;
            text-decoration: none; position: relative;
        }
        .nav-link-custom::after {
            content: ''; position: absolute;
            bottom: 0; left: 0.9rem; right: 0.9rem;
            height: 2px; background: var(--orange);
            transform: scaleX(0); transition: transform 0.2s ease;
            border-radius: 2px 2px 0 0;
        }
        .nav-link-custom:hover { color: var(--text-primary) !important; }
        .nav-link-custom:hover::after { transform: scaleX(1); }

        /* Login button */
        .btn-login {
            font-size: 0.82rem; font-weight: 600;
            color: var(--orange) !important;
            border: 1px solid rgba(249,115,22,0.35);
            border-radius: 6px;
            padding: 0.35rem 0.9rem !important;
            margin: auto 0.4rem;
            transition: all 0.2s ease;
        }
        .btn-login:hover { background: var(--orange-dim); border-color: var(--orange); }
        /* 覆蓋 nav-link-custom::after 避免登入按鈕也出現底線 */
        .btn-login::after { display: none !important; }

        /* User trigger — 覆蓋 Bootstrap 5 nav-link + dropdown-toggle 的所有預設 */
        /* 覆蓋 Bootstrap nav-link 所有預設 */
        .navbar-nav .nav-link.user-trigger,
        .user-trigger {
            display: flex !important;
            align-items: center;
            gap: 0.6rem;
            padding: 0.55rem 0.8rem !important;
            margin: 0.3rem 0;
            border-radius: 8px;
            cursor: pointer;
            transition: background 0.2s;
            color: var(--text-primary) !important;
            background: transparent;
        }

            .navbar-nav .nav-link.user-trigger:hover,
            .user-trigger:hover {
                background: var(--coal-soft) !important;
            }

            /* 隱藏 Bootstrap dropdown 箭頭 */
            .navbar-nav .nav-link.user-trigger::after,
            .navbar-nav .nav-link.user-trigger::before,
            .user-trigger::after,
            .user-trigger::before {
                display: none !important;
                content: none !important;
            }

        .user-avatar {
            width: 32px; height: 32px; border-radius: 8px;
            object-fit: cover; border: 1.5px solid rgba(249,115,22,0.4);
            flex-shrink: 0;
        }
        .user-name-text {
            font-size: 0.85rem; font-weight: 600;
            color: var(--text-primary);
            max-width: 110px; overflow: hidden;
            text-overflow: ellipsis; white-space: nowrap;
        }
        .caret-icon {
            font-size: 0.7rem; color: var(--text-muted);
            transition: transform 0.2s; flex-shrink: 0;
        }
        .user-trigger[aria-expanded="true"] .caret-icon { transform: rotate(180deg); }

        /* Dropdown menu */
        .dropdown-menu-custom {
            background: var(--coal-soft) !important;
            border: 1px solid var(--border) !important;
            border-radius: 10px !important;
            box-shadow: 0 16px 40px rgba(0,0,0,0.55) !important;
            padding: 0.4rem !important;
            min-width: 210px;
            margin-top: 6px !important;
        }
        .dropdown-user-header {
            padding: 0.7rem 0.8rem 0.8rem;
            border-bottom: 1px solid var(--border);
            margin-bottom: 0.3rem;
        }
        .dropdown-user-header .u-name { font-weight: 700; font-size: 0.88rem; color: var(--text-primary); }
        .dropdown-user-header .u-status {
            font-size: 0.72rem; color: var(--orange);
            font-family: 'DM Mono', monospace;
            display: flex; align-items: center; gap: 0.3rem; margin-top: 2px;
        }
        .status-dot { width: 5px; height: 5px; background: var(--orange); border-radius: 50%; }

        .dropdown-item-custom {
            display: flex; align-items: center; gap: 0.6rem;
            padding: 0.5rem 0.8rem; border-radius: 7px;
            font-size: 0.85rem; font-weight: 500;
            color: #c8c4be; text-decoration: none;
            transition: all 0.15s ease;
        }
        .dropdown-item-custom i { font-size: 0.9rem; color: var(--text-muted); width: 16px; text-align: center; }
        .dropdown-item-custom:hover { background: var(--orange-dim); color: var(--orange); }
        .dropdown-item-custom:hover i { color: var(--orange); }
        .dropdown-item-custom.logout { color: #e06060; margin-top: 0.2rem; }
        .dropdown-item-custom.logout i { color: #e06060; }
        .dropdown-item-custom.logout:hover { background: rgba(224,96,96,0.1); color: #ff7070; }

        .dropdown-sep { border-top: 1px solid var(--border); margin: 0.3rem 0; }

        /* Toggler */
        .navbar-toggler { border: 1px solid var(--border) !important; border-radius: 6px; padding: 0.3rem 0.5rem; }
        .navbar-toggler-icon { filter: invert(0.7); }

        /* Content */
        .container > main { padding-top: 2rem; }

        /* Footer */
        footer {
            font-size: 0.82rem; color: #aaa;
            background: #edeae5;
            border-top: 1px solid #ddd !important;
            padding: 1.2rem 0;
            font-family: 'DM Mono', monospace;
        }
        footer a { color: var(--orange); text-decoration: none; }
        footer a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid">

                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-dot"></span>
                    CourseWeb
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link-custom" asp-controller="Home" asp-action="Index">首頁</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link-custom" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        @if (!(User.Identity?.IsAuthenticated ?? false))
                        {
                            <li class="nav-item d-flex align-items-center">
                                <a class="nav-link-custom btn-login" asp-controller="User" asp-action="Login">登入</a>
                            </li>
                        }
                    </ul>

                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                            <li class="nav-item dropdown">
                                <a class="user-trigger nav-link dropdown-toggle"
                                   href="#"
                                   id="userDropdown"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    <img src="https://i.pravatar.cc/32" alt="avatar" class="user-avatar" />
                                    <span class="user-name-text">@User.Identity.Name</span>
                                    <i class="bi bi-chevron-down caret-icon"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-custom"
                                    aria-labelledby="userDropdown">
                                    <li>
                                        <div class="dropdown-user-header">
                                            <div class="u-name">@User.Identity.Name</div>
                                            <div class="u-status">
                                                <span class="status-dot"></span> 已登入
                                            </div>
                                        </div>
                                    </li>
                                    <li>
                                        <a class="dropdown-item-custom" href="/User/ChangeInfo">
                                            <i class="bi bi-person"></i> 會員資料
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item-custom" href="/Shop/Index">
                                            <i class="bi bi-journal-bookmark"></i> 課程管理
                                        </a>
                                    </li>
                                    <li><div class="dropdown-sep"></div></li>
                                    <li>
                                        <a class="dropdown-item-custom logout" href="/User/Logout">
                                            <i class="bi bi-box-arrow-right"></i> 登出
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 — CourseWeb &nbsp;·&nbsp;
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
