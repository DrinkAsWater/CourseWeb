@model CourseWeb.Models.UserChgInfoViewModel
@{
    ViewData["Title"] = "ChangeInfo";
}

<style>
    .member-container {
        max-width: 600px;
        margin: 3rem auto;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

    .member-card {
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        background: #fff;
    }

    .member-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        padding: 2rem;
        text-align: center;
    }

        .member-header h2 {
            margin: 0;
            font-size: 1.8rem;
        }

        .member-header p {
            margin: 0.5rem 0 0;
            font-size: 0.95rem;
            opacity: 0.85;
        }

    .member-body {
        padding: 2rem;
    }

    .section-divider {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin: 1.8rem 0 1.5rem;
        color: #888;
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

        .section-divider::before,
        .section-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #e5e5e5;
        }

    .form-group-modern {
        margin-bottom: 1.4rem;
        position: relative;
    }

    .form-label-modern {
        display: flex;
        align-items: center;
        font-weight: 600;
        color: #333;
        margin-bottom: 0.5rem;
    }

        .form-label-modern i {
            margin-right: 0.5rem;
            color: #667eea;
            font-size: 1.1rem;
        }

    .form-control-modern {
        width: 100%;
        padding: 0.7rem 1rem;
        border-radius: 10px;
        border: 1.5px solid #ddd;
        transition: all 0.3s ease;
        font-size: 1rem;
    }

        .form-control-modern:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);
        }

    .btn-save {
        width: 100%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        font-weight: 600;
        font-size: 1rem;
        border: none;
        padding: 0.8rem 0;
        border-radius: 25px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
    }

        .btn-save:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(102,126,234,0.4);
        }

    .btn-pwd {
        width: 100%;
        background: #fff;
        color: #667eea;
        font-weight: 600;
        font-size: 0.95rem;
        border: 2px solid #667eea;
        padding: 0.7rem 0;
        border-radius: 25px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        margin-top: 0.5rem;
    }

        .btn-pwd:hover {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(102,126,234,0.3);
        }

    .alert-modern {
        border-radius: 12px;
        padding: 1rem 1.5rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 500;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .alert-success-modern {
        background: #d4edda;
        color: #155724;
    }

    .google-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: #f1f3f4;
        color: #555;
        font-size: 0.82rem;
        padding: 0.35rem 0.8rem;
        border-radius: 20px;
        margin-top: 0.5rem;
    }
</style>

<div class="member-container">
    <div class="member-card">
        <div class="member-header">
            <h2>👤 會員資料</h2>
            <p>管理您的個人資訊與帳號安全</p>
        </div>
        <div class="member-body">

            @if (ViewBag.Result != null)
            {
                <div class="alert-modern alert-success-modern">
                    <i class="bi bi-check-circle-fill"></i>
                    @ViewBag.Result
                </div>
            }

            <!-- 基本資料 -->
            <div class="section-divider">基本資料</div>

            <form asp-action="ChangeInfo" method="post">
                @Html.AntiForgeryToken()

                <div class="form-group-modern">
                    <label class="form-label-modern">
                        <i class="bi bi-person-fill"></i> 姓名
                    </label>
                    <input type="text" asp-for="Name" class="form-control-modern" placeholder="請輸入您的姓名" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group-modern">
                    <label class="form-label-modern">
                        <i class="bi bi-phone-fill"></i> 手機號碼
                    </label>
                    <input type="tel" asp-for="Mobile" class="form-control-modern" placeholder="請輸入您的手機號碼" />
                    <span asp-validation-for="Mobile" class="text-danger"></span>
                </div>

                <div class="form-group-modern">
                    <button type="submit" class="btn-save">
                        <i class="bi bi-save"></i> 儲存變更
                    </button>
                </div>
            </form>

            <!-- 帳號安全 -->
            <div class="section-divider">帳號安全</div>

            @if (Model.HasPassword)
            {
                <!-- 本地帳號 → 顯示修改密碼 -->
                <a asp-controller="User" asp-action="ChangePwd" class="btn-pwd">
                    <i class="bi bi-shield-lock"></i> 修改密碼
                </a>
            }
            else
            {
                <!-- Google 帳號 → 顯示新增密碼 -->
                <div class="mb-2">
                    <span class="google-badge">
                        <i class="bi bi-google"></i> 您目前使用 Google 登入，尚未設定密碼
                    </span>
                </div>
                <a asp-controller="User" asp-action="SetPassword" class="btn-pwd">
                    <i class="bi bi-plus-circle"></i> 新增密碼
                </a>
            }

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
