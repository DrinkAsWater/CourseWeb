@model CourseWeb.Models.SetPasswordViewModel
@{
    ViewData["Title"] = "SetPassword";
}

<style>
    .member-container {
        max-width: 600px;
        margin: 3rem auto;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

    .member-card {
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        background: #fff;
    }

    .member-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        padding: 2rem;
        text-align: center;
    }
    .member-header h2 { margin: 0; font-size: 1.8rem; }
    .member-header p  { margin: 0.5rem 0 0; font-size: 0.95rem; opacity: 0.85; }

    .member-body { padding: 2rem; }

    .form-group-modern { margin-bottom: 1.4rem; }

    .form-label-modern {
        display: flex;
        align-items: center;
        font-weight: 600;
        color: #333;
        margin-bottom: 0.5rem;
    }
    .form-label-modern i { margin-right: 0.5rem; color: #667eea; font-size: 1.1rem; }

    .form-control-modern {
        width: 100%;
        padding: 0.7rem 1rem;
        border-radius: 10px;
        border: 1.5px solid #ddd;
        transition: all 0.3s ease;
        font-size: 1rem;
    }
    .form-control-modern:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.15);
    }

    .btn-save {
        width: 100%;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: #fff;
        font-weight: 600;
        font-size: 1rem;
        border: none;
        padding: 0.8rem 0;
        border-radius: 25px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.8rem;
    }
    .btn-save:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(102,126,234,0.4);
    }

    .btn-back {
        width: 100%;
        background: #fff;
        color: #667eea;
        font-weight: 600;
        font-size: 0.95rem;
        border: 2px solid #667eea;
        padding: 0.7rem 0;
        border-radius: 25px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
    }
    .btn-back:hover {
        background: #f0f0ff;
        transform: translateY(-2px);
    }

    .hint {
        background: #f8f9ff;
        border-left: 4px solid #667eea;
        border-radius: 0 8px 8px 0;
        padding: 0.8rem 1rem;
        margin-bottom: 1.5rem;
        font-size: 0.82rem;
        color: #555;
        line-height: 1.6;
    }

    .alert-danger-modern {
        background: #fde8e8;
        color: #a00;
        border-radius: 10px;
        padding: 0.8rem 1rem;
        margin-bottom: 1rem;
        font-size: 0.85rem;
    }
</style>

<div class="member-container">
    <div class="member-card">
        <div class="member-header">
            <h2>🔐 新增密碼</h2>
            <p>設定密碼後也可以使用帳號密碼登入</p>
        </div>
        <div class="member-body">

            <div class="hint">
                密碼需包含至少一個大寫字母、一個小寫字母和一個數字，長度 6～20 個字元。
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert-danger-modern">
                    <i class="bi bi-exclamation-circle"></i>
                    請確認輸入資料是否正確
                </div>
            }

            <form asp-action="SetPassword" method="post">
                @Html.AntiForgeryToken()

                <div class="form-group-modern">
                    <label class="form-label-modern">
                        <i class="bi bi-lock-fill"></i> 新密碼
                    </label>
                    <input type="password" asp-for="Password" class="form-control-modern" placeholder="請輸入新密碼" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group-modern">
                    <label class="form-label-modern">
                        <i class="bi bi-shield-check"></i> 確認密碼
                    </label>
                    <input type="password" asp-for="ConfirmPwd" class="form-control-modern" placeholder="請再次輸入新密碼" />
                    <span asp-validation-for="ConfirmPwd" class="text-danger"></span>
                </div>

                <div class="form-group-modern">
                    <button type="submit" class="btn-save">
                        <i class="bi bi-plus-circle"></i> 確認新增密碼
                    </button>
                    <a asp-controller="User" asp-action="ChangeInfo" class="btn-back">
                        <i class="bi bi-arrow-left"></i> 返回會員資料
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
